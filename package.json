{
  "name": "n8n-nodes-onpath",
  "version": "0.1.1",
  "description": "n8n community node — push KPI values into onPATH Studio",
  "keywords": [
    "n8n-community-node-package",
    "kpi",
    "canvas",
    "analytics"
  ],
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/kpi-zone/onpath-n8n-connector",
  "repository": {
    "type": "git",
    "url": "https://github.com/kpi-zone/onpath-n8n-connector.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/KpiCanvasApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/KpiCanvas/KpiCanvas.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
